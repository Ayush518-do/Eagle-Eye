# Copy this file to .env for local development. Never commit .env.
APP_NAME=Eagle Eye
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./eagle_eye.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# Optional: paths to locally stored models. Do not commit model weights.
DETECTOR_WEIGHTS_PATH=
DETECTOR_MODEL_NAME=
# Frontend (read by Vite)
VITE_API_URL=http://127.0.0.1:8000
